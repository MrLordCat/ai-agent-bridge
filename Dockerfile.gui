FROM node:22-bookworm-slim

ARG VSCODE_VERSION=1.141.0

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl git tini \
    xvfb x11vnc novnc websockify x11-utils x11-xkb-utils \
    xfce4-session xfce4-panel xfwm4 xfdesktop4 xfce4-settings \
    xfce4-terminal thunar dbus-x11 xdg-utils firefox-esr \
    fonts-dejavu-core adwaita-icon-theme \
    libx11-xcb1 libxcb-dri3-0 libdrm2 libgbm1 libasound2 \
    libatk1.0-0 libatk-bridge2.0-0 libcups2 libgtk-3-0 libnss3 \
    libxcomposite1 libxdamage1 libxrandr2 libxss1 libxtst6 \
    libpango-1.0-0 libcairo2 libgdk-pixbuf-2.0-0 \
    && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /opt/vscode-system /home/node/apps /home/node/Desktop /home/node/workspace /packages \
    && curl --fail --location --retry 3 \
       "https://update.code.visualstudio.com/${VSCODE_VERSION}/linux-x64/stable" \
       --output /tmp/vscode.tar.gz \
    && tar -xzf /tmp/vscode.tar.gz --no-same-owner --strip-components=1 -C /opt/vscode-system \
    && rm /tmp/vscode.tar.gz \
    && cp -R /opt/vscode-system /home/node/apps/vscode \
    && chown -R node:node /home/node

COPY scripts/debian/gui/entrypoint.sh /usr/local/bin/bridge-gui
COPY scripts/debian/gui/code-user.sh /usr/local/bin/code
COPY scripts/debian/gui/code-system.sh /usr/local/bin/code-system
COPY --chown=node:node scripts/debian/gui/desktop/ /home/node/Desktop/
COPY --chown=node:node scripts/debian/gui/README.txt /home/node/Desktop/README.txt
RUN chmod +x /usr/local/bin/bridge-gui /usr/local/bin/code /usr/local/bin/code-system \
    /home/node/Desktop/*.desktop \
    && ln -s /packages /home/node/Desktop/VSIX-Packages

ENV DISPLAY=:1 \
    HOME=/home/node \
    USER=node \
    LOGNAME=node \
    XDG_RUNTIME_DIR=/tmp/bridge-gui-runtime \
    LANG=C.UTF-8 \
    BROWSER=firefox-esr \
    DONT_PROMPT_WSL_INSTALL=1 \
    GUI_RESOLUTION=1440x900

EXPOSE 6080
HEALTHCHECK --interval=10s --timeout=3s --start-period=30s \
    CMD curl --fail --silent http://127.0.0.1:6080/vnc.html > /dev/null || exit 1

USER node
WORKDIR /home/node/workspace
ENTRYPOINT ["tini", "-g", "--", "/usr/local/bin/bridge-gui"]
